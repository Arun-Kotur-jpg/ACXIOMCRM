@model AcxiomCRM.Models.ViewModels.FollowUpListViewModel
@using AcxiomCRM.Models.Enums

@{
    ViewData["Title"] = "Follow-Ups";
    var followUps = Model.FollowUps;
    var today = DateTime.Today;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0"><i class="bi bi-calendar-check me-2"></i>Follow-Ups</h1>
        <p class="text-muted mb-0">Manage and track scheduled follow-ups</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>New Follow-Up
    </a>
</div>

<!-- Scope Tabs -->
<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(Model.FilterScope == "All" ? "active" : "")"
           asp-action="Index" asp-route-scope="All">
            All
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.FilterScope == "Upcoming" ? "active" : "")"
           asp-action="Index" asp-route-scope="Upcoming">
            Upcoming
            @if (Model.UpcomingCount > 0)
            {
                <span class="badge bg-info ms-1">@Model.UpcomingCount</span>
            }
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.FilterScope == "Overdue" ? "active" : "")"
           asp-action="Index" asp-route-scope="Overdue">
            Overdue
            @if (Model.OverdueCount > 0)
            {
                <span class="badge bg-danger ms-1">@Model.OverdueCount</span>
            }
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.FilterScope == "Today" ? "active" : "")"
           asp-action="Index" asp-route-scope="Today">
            Today
        </a>
    </li>
</ul>

<!-- Filters -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get">
            <input type="hidden" name="scope" value="@Model.FilterScope" />
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Search</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchTerm" class="form-control" placeholder="Search subject..."
                               value="@Model.SearchTerm" />
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Status</label>
                    <select name="statusFilter" class="form-select">
                        <option value="">All Statuses</option>
                        @foreach (var status in Enum.GetValues<FollowUpStatus>())
                        {
                            <option value="@((int)status)" selected="@(Model.StatusFilter == status)">@status</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Type</label>
                    <select name="typeFilter" class="form-select">
                        <option value="">All Types</option>
                        @foreach (var type in Enum.GetValues<FollowUpType>())
                        {
                            <option value="@((int)type)" selected="@(Model.TypeFilter == type)">@type</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Assigned To</label>
                    <select name="assigneeFilter" class="form-select" asp-items="Model.AvailableAssignees">
                        <option value="">All Assignees</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="bi bi-funnel me-1"></i>Apply
                    </button>
                    <a asp-action="Index" asp-route-scope="@Model.FilterScope" class="btn btn-outline-secondary">
                        <i class="bi bi-x-lg me-1"></i>Clear
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Results Table -->
@if (followUps.Items != null && followUps.Items.Any())
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Subject</th>
                        <th>Type</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Related To</th>
                        <th>Assigned To</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in followUps.Items)
                    {
                        var isOverdue = item.Status == FollowUpStatus.Planned && item.FollowUpDate.Date < today;
                        <tr>
                            <td>
                                <span class="fw-semibold">@item.Subject</span>
                            </td>
                            <td>
                                @{
                                    var typeBadge = item.FollowUpType switch
                                    {
                                        FollowUpType.Call => "primary",
                                        FollowUpType.Meeting => "success",
                                        FollowUpType.Email => "info",
                                        FollowUpType.Task => "warning",
                                        _ => "secondary"
                                    };
                                    var typeIcon = item.FollowUpType switch
                                    {
                                        FollowUpType.Call => "bi-telephone",
                                        FollowUpType.Meeting => "bi-people",
                                        FollowUpType.Email => "bi-envelope",
                                        FollowUpType.Task => "bi-list-task",
                                        _ => "bi-tag"
                                    };
                                }
                                <span class="badge bg-@typeBadge">
                                    <i class="bi @typeIcon me-1"></i>@item.FollowUpType
                                </span>
                            </td>
                            <td>
                                @if (isOverdue)
                                {
                                    <span class="text-danger fw-semibold">
                                        <i class="bi bi-exclamation-triangle me-1"></i>@item.FollowUpDate.ToString("MMM dd, yyyy hh:mm tt")
                                    </span>
                                }
                                else
                                {
                                    <span>@item.FollowUpDate.ToString("MMM dd, yyyy hh:mm tt")</span>
                                }
                            </td>
                            <td>
                                @{
                                    var statusBadge = item.Status switch
                                    {
                                        FollowUpStatus.Planned => "info",
                                        FollowUpStatus.Completed => "success",
                                        FollowUpStatus.Missed => "danger",
                                        FollowUpStatus.Cancelled => "secondary",
                                        _ => "secondary"
                                    };
                                }
                                <span class="badge bg-@statusBadge">@item.Status</span>
                            </td>
                            <td>
                                @if (item.Customer != null)
                                {
                                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@item.CustomerId" class="text-decoration-none">
                                        <i class="bi bi-person me-1"></i>@item.Customer.CustomerName
                                    </a>
                                }
                                else if (item.Lead != null)
                                {
                                    <a asp-controller="Leads" asp-action="Details" asp-route-id="@item.LeadId" class="text-decoration-none">
                                        <i class="bi bi-funnel me-1"></i>@item.Lead.LeadName
                                    </a>
                                }
                                else if (item.Opportunity != null)
                                {
                                    <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@item.OpportunityId" class="text-decoration-none">
                                        <i class="bi bi-trophy me-1"></i>@item.Opportunity.OpportunityName
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (item.AssignedToUser != null)
                                {
                                    <span><i class="bi bi-person-circle me-1"></i>@item.AssignedToUser.FullName</span>
                                }
                                else
                                {
                                    <span class="text-muted">Unassigned</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (item.Status == FollowUpStatus.Planned)
                                {
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                                                data-bs-toggle="dropdown" aria-expanded="false">
                                            Actions
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm p-3" style="min-width: 320px;">
                                            <li class="mb-3">
                                                <h6 class="dropdown-header px-0"><i class="bi bi-check-circle me-1"></i>Mark Complete</h6>
                                                <form asp-action="Complete" method="post">
                                                    <input type="hidden" name="id" value="@item.FollowUpId" />
                                                    <div class="mb-2">
                                                        <input type="text" name="remarks" class="form-control form-control-sm"
                                                               placeholder="Completion remarks..." />
                                                    </div>
                                                    <button type="submit" class="btn btn-success btn-sm w-100">
                                                        <i class="bi bi-check-lg me-1"></i>Complete
                                                    </button>
                                                </form>
                                            </li>
                                            <li><hr class="dropdown-divider" /></li>
                                            <li class="mb-3">
                                                <h6 class="dropdown-header px-0"><i class="bi bi-calendar-event me-1"></i>Reschedule</h6>
                                                <form asp-action="Reschedule" method="post">
                                                    <input type="hidden" name="id" value="@item.FollowUpId" />
                                                    <div class="mb-2">
                                                        <input type="datetime-local" name="newDate" class="form-control form-control-sm" required />
                                                    </div>
                                                    <div class="mb-2">
                                                        <input type="text" name="remarks" class="form-control form-control-sm"
                                                               placeholder="Reschedule reason..." />
                                                    </div>
                                                    <button type="submit" class="btn btn-warning btn-sm w-100">
                                                        <i class="bi bi-arrow-repeat me-1"></i>Reschedule
                                                    </button>
                                                </form>
                                            </li>
                                            <li><hr class="dropdown-divider" /></li>
                                            <li>
                                                <h6 class="dropdown-header px-0"><i class="bi bi-x-circle me-1"></i>Cancel</h6>
                                                <form asp-action="Cancel" method="post"
                                                      onsubmit="return confirm('Are you sure you want to cancel this follow-up?');">
                                                    <input type="hidden" name="id" value="@item.FollowUpId" />
                                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                                        <i class="bi bi-x-lg me-1"></i>Cancel Follow-Up
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-@statusBadge">@item.Status</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (followUps.TotalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center">
                <span class="text-muted">
                    Showing @((followUps.CurrentPage - 1) * followUps.PageSize + 1)–@(Math.Min(followUps.CurrentPage * followUps.PageSize, followUps.TotalCount))
                    of @followUps.TotalCount follow-ups
                </span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(followUps.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@(followUps.CurrentPage - 1)"
                               asp-route-scope="@Model.FilterScope"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-statusFilter="@(Model.StatusFilter.HasValue ? ((int)Model.StatusFilter.Value).ToString() : "")"
                               asp-route-typeFilter="@(Model.TypeFilter.HasValue ? ((int)Model.TypeFilter.Value).ToString() : "")"
                               asp-route-assigneeFilter="@Model.AssigneeFilter">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        @for (int i = 1; i <= followUps.TotalPages; i++)
                        {
                            <li class="page-item @(i == followUps.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-scope="@Model.FilterScope"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-statusFilter="@(Model.StatusFilter.HasValue ? ((int)Model.StatusFilter.Value).ToString() : "")"
                                   asp-route-typeFilter="@(Model.TypeFilter.HasValue ? ((int)Model.TypeFilter.Value).ToString() : "")"
                                   asp-route-assigneeFilter="@Model.AssigneeFilter">
                                    @i
                                </a>
                            </li>
                        }
                        <li class="page-item @(followUps.CurrentPage == followUps.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@(followUps.CurrentPage + 1)"
                               asp-route-scope="@Model.FilterScope"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-statusFilter="@(Model.StatusFilter.HasValue ? ((int)Model.StatusFilter.Value).ToString() : "")"
                               asp-route-typeFilter="@(Model.TypeFilter.HasValue ? ((int)Model.TypeFilter.Value).ToString() : "")"
                               asp-route-assigneeFilter="@Model.AssigneeFilter">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-calendar-x display-4 text-muted"></i>
            <h5 class="mt-3 text-muted">No Follow-Ups Found</h5>
            <p class="text-muted mb-3">
                @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.StatusFilter.HasValue || Model.TypeFilter.HasValue)
                {
                    <span>No follow-ups match the current filters. Try adjusting your search criteria.</span>
                }
                else
                {
                    <span>Get started by scheduling your first follow-up.</span>
                }
            </p>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>New Follow-Up
            </a>
        </div>
    </div>
}
