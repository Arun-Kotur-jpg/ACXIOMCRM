@model AcxiomCRM.Models.ViewModels.FollowUpCreateEditViewModel
@using AcxiomCRM.Models.Enums

@{
    ViewData["Title"] = "Edit Follow-Up";
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary me-3">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h1 class="h3 mb-0"><i class="bi bi-pencil-square me-2"></i>Edit Follow-Up</h1>
        <p class="text-muted mb-0">Update follow-up details</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.FollowUpId" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <input type="hidden" asp-for="FollowUpId" />

                    <!-- Subject -->
                    <div class="mb-3">
                        <label asp-for="Subject" class="form-label fw-semibold">
                            Subject <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Subject" class="form-control" placeholder="Enter follow-up subject" />
                        <span asp-validation-for="Subject" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <!-- Follow-Up Type -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="FollowUpType" class="form-label fw-semibold">
                                Type <span class="text-danger">*</span>
                            </label>
                            <select asp-for="FollowUpType" class="form-select"
                                    asp-items="Html.GetEnumSelectList<FollowUpType>()">
                                <option value="">— Select Type —</option>
                            </select>
                            <span asp-validation-for="FollowUpType" class="text-danger small"></span>
                        </div>

                        <!-- Status -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="Status" class="form-label fw-semibold">
                                Status <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Status" class="form-select"
                                    asp-items="Html.GetEnumSelectList<FollowUpStatus>()">
                                <option value="">— Select Status —</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Follow-Up Date -->
                    <div class="mb-3">
                        <label asp-for="FollowUpDate" class="form-label fw-semibold">
                            Date &amp; Time <span class="text-danger">*</span>
                        </label>
                        <input asp-for="FollowUpDate" type="datetime-local" class="form-control" />
                        <span asp-validation-for="FollowUpDate" class="text-danger small"></span>
                    </div>

                    <hr class="my-4" />
                    <h6 class="text-muted mb-3"><i class="bi bi-link-45deg me-1"></i>Related To (Optional)</h6>

                    <div class="row">
                        <!-- Customer -->
                        <div class="col-md-4 mb-3">
                            <label asp-for="CustomerId" class="form-label fw-semibold">Customer</label>
                            <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers">
                                <option value="">— None —</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <!-- Lead -->
                        <div class="col-md-4 mb-3">
                            <label asp-for="LeadId" class="form-label fw-semibold">Lead</label>
                            <select asp-for="LeadId" class="form-select" asp-items="ViewBag.Leads">
                                <option value="">— None —</option>
                            </select>
                            <span asp-validation-for="LeadId" class="text-danger small"></span>
                        </div>

                        <!-- Opportunity -->
                        <div class="col-md-4 mb-3">
                            <label asp-for="OpportunityId" class="form-label fw-semibold">Opportunity</label>
                            <select asp-for="OpportunityId" class="form-select" asp-items="ViewBag.Opportunities">
                                <option value="">— None —</option>
                            </select>
                            <span asp-validation-for="OpportunityId" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <!-- Assigned To -->
                    <div class="mb-3">
                        <label asp-for="AssignedTo" class="form-label fw-semibold">
                            Assigned To <span class="text-danger">*</span>
                        </label>
                        <select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.Users">
                            <option value="">— Select Assignee —</option>
                        </select>
                        <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                    </div>

                    <!-- Remarks -->
                    <div class="mb-4">
                        <label asp-for="Remarks" class="form-label fw-semibold">Remarks</label>
                        <textarea asp-for="Remarks" class="form-control" rows="3"
                                  placeholder="Additional notes or remarks..."></textarea>
                        <span asp-validation-for="Remarks" class="text-danger small"></span>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg me-1"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
