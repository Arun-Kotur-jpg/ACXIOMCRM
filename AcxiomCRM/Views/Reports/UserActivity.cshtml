@model AcxiomCRM.Models.ViewModels.UserActivityReportViewModel
@{
    ViewData["Title"] = "User Activity Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">User Activity &amp; Productivity</h1>
        <p class="text-secondary small mb-0">Track representative actions, customer interactions, and audit trail metrics</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Reports Hub
    </a>
</div>

<!-- Date Filter Card -->
<div class="card shadow-sm border mb-4">
    <div class="card-body">
        <form method="get" asp-action="UserActivity" class="row g-3">
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-secondary">Start Date</label>
                <input type="date" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-secondary">End Date</label>
                <input type="date" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-md-4 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel me-1"></i> Apply Filter
                </button>
                <a asp-action="UserActivity" class="btn btn-outline-secondary" title="Reset">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Activity Breakdown Table Card -->
<div class="card shadow-sm border">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>User</th>
                    <th>Role</th>
                    <th>Total Logged Activities</th>
                    <th>Calls</th>
                    <th>Meetings</th>
                    <th>Emails</th>
                    <th>Tasks</th>
                    <th>Audit Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.UserActivities.Any())
                {
                    @foreach (var user in Model.UserActivities)
                    {
                        var roleBadge = user.Role switch
                        {
                            RoleConstants.Admin => "bg-danger",
                            RoleConstants.Manager => "bg-warning text-dark",
                            _ => "bg-info text-dark"
                        };

                        <tr>
                            <td class="fw-semibold text-dark">
                                <i class="bi bi-person-circle text-secondary me-2"></i>@user.UserName
                            </td>
                            <td><span class="badge @roleBadge">@user.Role</span></td>
                            <td>
                                <span class="badge bg-primary fs-6">@user.TotalActivities</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-telephone me-1 text-primary"></i>@user.CallsCount
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-people me-1 text-success"></i>@user.MeetingsCount
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-envelope me-1 text-info"></i>@user.EmailsCount
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-check2-square me-1 text-warning"></i>@user.TasksCount
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-light text-secondary border">@user.AuditActionsCount</span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-secondary">
                            No user activity logged in the selected period.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

