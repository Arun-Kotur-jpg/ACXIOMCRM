@{
    ViewData["Title"] = "Reports & Analytics";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">
            <i class="bi bi-bar-chart-line me-2"></i>Reports & Analytics
        </h1>
        <p class="text-muted mb-0">Generate insights from your CRM data with comprehensive reports and analytics.</p>
    </div>
</div>

<div class="row g-4">
    <!-- Customer Report -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-primary bg-opacity-10 rounded-3 p-3 me-3">
                        <i class="bi bi-people text-primary fs-4"></i>
                    </div>
                    <h5 class="card-title mb-0">Customer Report</h5>
                </div>
                <p class="card-text text-muted flex-grow-1">View customer data by status, owner and date range.</p>
                <a asp-action="Customers" class="btn btn-outline-primary mt-2">
                    <i class="bi bi-eye me-1"></i>View Report
                </a>
            </div>
        </div>
    </div>

    <!-- Lead Report -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-success bg-opacity-10 rounded-3 p-3 me-3">
                        <i class="bi bi-person-plus text-success fs-4"></i>
                    </div>
                    <h5 class="card-title mb-0">Lead Report</h5>
                </div>
                <p class="card-text text-muted flex-grow-1">Analyze leads by status, source and conversion.</p>
                <a asp-action="Leads" class="btn btn-outline-success mt-2">
                    <i class="bi bi-eye me-1"></i>View Report
                </a>
            </div>
        </div>
    </div>

    <!-- Opportunity Report -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-info bg-opacity-10 rounded-3 p-3 me-3">
                        <i class="bi bi-briefcase text-info fs-4"></i>
                    </div>
                    <h5 class="card-title mb-0">Opportunity Report</h5>
                </div>
                <p class="card-text text-muted flex-grow-1">Review opportunity pipeline and deal stages.</p>
                <a asp-action="Opportunities" class="btn btn-outline-info mt-2">
                    <i class="bi bi-eye me-1"></i>View Report
                </a>
            </div>
        </div>
    </div>

    <!-- Follow-Up Report -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-warning bg-opacity-10 rounded-3 p-3 me-3">
                        <i class="bi bi-calendar-check text-warning fs-4"></i>
                    </div>
                    <h5 class="card-title mb-0">Follow-Up Report</h5>
                </div>
                <p class="card-text text-muted flex-grow-1">Track follow-up completion and overdue items.</p>
                <a asp-action="FollowUps" class="btn btn-outline-warning mt-2">
                    <i class="bi bi-eye me-1"></i>View Report
                </a>
            </div>
        </div>
    </div>

    <!-- Pipeline Report -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-danger bg-opacity-10 rounded-3 p-3 me-3">
                        <i class="bi bi-funnel text-danger fs-4"></i>
                    </div>
                    <h5 class="card-title mb-0">Pipeline Report</h5>
                </div>
                <p class="card-text text-muted flex-grow-1">Sales pipeline analysis by stage and owner.</p>
                <a asp-action="Pipeline" class="btn btn-outline-danger mt-2">
                    <i class="bi bi-eye me-1"></i>View Report
                </a>
            </div>
        </div>
    </div>

    <!-- Conversion Report -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-secondary bg-opacity-10 rounded-3 p-3 me-3">
                        <i class="bi bi-arrow-left-right text-secondary fs-4"></i>
                    </div>
                    <h5 class="card-title mb-0">Conversion Report</h5>
                </div>
                <p class="card-text text-muted flex-grow-1">Lead-to-customer conversion metrics.</p>
                <a asp-action="Conversion" class="btn btn-outline-secondary mt-2">
                    <i class="bi bi-eye me-1"></i>View Report
                </a>
            </div>
        </div>
    </div>

    <!-- User Activity Report -->
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body d-flex flex-column">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-dark bg-opacity-10 rounded-3 p-3 me-3">
                        <i class="bi bi-person-workspace text-dark fs-4"></i>
                    </div>
                    <h5 class="card-title mb-0">User Activity Report</h5>
                </div>
                <p class="card-text text-muted flex-grow-1">Individual user activity and productivity.</p>
                <a asp-action="UserActivity" class="btn btn-outline-dark mt-2">
                    <i class="bi bi-eye me-1"></i>View Report
                </a>
            </div>
        </div>
    </div>
</div>
