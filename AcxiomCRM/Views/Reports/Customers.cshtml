@model AcxiomCRM.Models.ViewModels.PagedResult<AcxiomCRM.Models.Entities.Customer>
@{
    ViewData["Title"] = "Customer Report";
    var filter = (AcxiomCRM.Models.ViewModels.BaseReportFilter)ViewBag.Filter;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">Customer Report</h1>
        <p class="text-secondary small mb-0">Overview of customers, contact details, account status, and owners</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Reports Hub
        </a>
        <a asp-action="ExportCustomersCsv" 
           asp-route-searchTerm="@filter.SearchTerm"
           asp-route-ownerId="@filter.OwnerId"
           asp-route-startDate="@filter.StartDate?.ToString("yyyy-MM-dd")"
           asp-route-endDate="@filter.EndDate?.ToString("yyyy-MM-dd")"
           class="btn btn-success">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
        </a>
    </div>
</div>

<!-- Filters -->
<div class="card shadow-sm border mb-4">
    <div class="card-body">
        <form method="get" asp-action="Customers" class="row g-3">
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary">Search</label>
                <input type="text" name="SearchTerm" value="@filter.SearchTerm" class="form-control" placeholder="Customer name, code, company..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary">Owner</label>
                <select name="OwnerId" class="form-select" asp-items="ViewBag.AvailableOwners">
                    <option value="">All Owners</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-secondary">Start Date</label>
                <input type="date" name="StartDate" value="@(filter.StartDate?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-secondary">End Date</label>
                <input type="date" name="EndDate" value="@(filter.EndDate?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel me-1"></i> Apply
                </button>
                <a asp-action="Customers" class="btn btn-outline-secondary" title="Reset">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Table Card -->
<div class="card shadow-sm border">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Code</th>
                    <th>Customer Name</th>
                    <th>Company</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>City / State</th>
                    <th>Status</th>
                    <th>Owner</th>
                    <th>Created Date</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    @foreach (var c in Model.Items)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border">@c.CustomerCode</span></td>
                            <td class="fw-semibold">
                                <a asp-controller="Customers" asp-action="Details" asp-route-id="@c.CustomerId" class="text-decoration-none">
                                    @c.CustomerName
                                </a>
                            </td>
                            <td>@(c.CompanyName ?? "—")</td>
                            <td>@c.Email</td>
                            <td>@c.Phone</td>
                            <td>@($"{c.City}, {c.State}".Trim(',', ' '))</td>
                            <td>
                                <span class="badge @(c.Status == CustomerStatus.Active ? "bg-success" : "bg-secondary")">
                                    @c.Status
                                </span>
                            </td>
                            <td>@(c.Owner?.FullName ?? "Unassigned")</td>
                            <td class="text-secondary small">@c.CreatedDate.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-secondary">
                            No customers found for this report filter.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-secondary">
                Showing @(((Model.PageNumber - 1) * Model.PageSize) + 1) to @(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount)) of @Model.TotalCount customers
            </span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link" asp-action="Customers"
                           asp-route-page="@(Model.PageNumber - 1)"
                           asp-route-SearchTerm="@filter.SearchTerm"
                           asp-route-OwnerId="@filter.OwnerId"
                           asp-route-StartDate="@filter.StartDate?.ToString("yyyy-MM-dd")"
                           asp-route-EndDate="@filter.EndDate?.ToString("yyyy-MM-dd")">Previous</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" asp-action="Customers"
                               asp-route-page="@i"
                               asp-route-SearchTerm="@filter.SearchTerm"
                               asp-route-OwnerId="@filter.OwnerId"
                               asp-route-StartDate="@filter.StartDate?.ToString("yyyy-MM-dd")"
                               asp-route-EndDate="@filter.EndDate?.ToString("yyyy-MM-dd")">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                        <a class="page-link" asp-action="Customers"
                           asp-route-page="@(Model.PageNumber + 1)"
                           asp-route-SearchTerm="@filter.SearchTerm"
                           asp-route-OwnerId="@filter.OwnerId"
                           asp-route-StartDate="@filter.StartDate?.ToString("yyyy-MM-dd")"
                           asp-route-EndDate="@filter.EndDate?.ToString("yyyy-MM-dd")">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

