@model AcxiomCRM.Models.ViewModels.PagedResult<AcxiomCRM.Models.Entities.Opportunity>
@{
    ViewData["Title"] = "Opportunity Report";
    var filter = (AcxiomCRM.Models.ViewModels.BaseReportFilter)ViewBag.Filter;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">Opportunity Report</h1>
        <p class="text-secondary small mb-0">Track opportunity deal values, sales stages, and pipeline probabilities</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Reports Hub
        </a>
        <a asp-action="ExportOpportunitiesCsv"
           asp-route-searchTerm="@filter.SearchTerm"
           asp-route-ownerId="@filter.OwnerId"
           asp-route-startDate="@filter.StartDate?.ToString("yyyy-MM-dd")"
           asp-route-endDate="@filter.EndDate?.ToString("yyyy-MM-dd")"
           asp-route-stage="@ViewBag.Stage"
           class="btn btn-success">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
        </a>
    </div>
</div>

<!-- Filters -->
<div class="card shadow-sm border mb-4">
    <div class="card-body">
        <form method="get" asp-action="Opportunities" class="row g-3">
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary">Search</label>
                <input type="text" name="SearchTerm" value="@filter.SearchTerm" class="form-control" placeholder="Opportunity or customer..." />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-secondary">Stage</label>
                <select name="stage" class="form-select" asp-items="Html.GetEnumSelectList<AcxiomCRM.Models.Enums.OpportunityStage>()">
                    <option value="">All Stages</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-secondary">Assigned To</label>
                <select name="OwnerId" class="form-select" asp-items="ViewBag.AvailableOwners">
                    <option value="">All Users</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-secondary">Start Date</label>
                <input type="date" name="StartDate" value="@(filter.StartDate?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-secondary">End Date</label>
                <input type="date" name="EndDate" value="@(filter.EndDate?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100" title="Apply Filter">
                    <i class="bi bi-funnel"></i>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Table Card -->
<div class="card shadow-sm border">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Opportunity Name</th>
                    <th>Customer</th>
                    <th>Amount</th>
                    <th>Stage</th>
                    <th>Prob.</th>
                    <th>Weighted Value</th>
                    <th>Status</th>
                    <th>Assigned To</th>
                    <th>Close Date</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    @foreach (var o in Model.Items)
                    {
                        var stageBadge = o.Stage switch
                        {
                            OpportunityStage.Qualification => "badge-stage-qual",
                            OpportunityStage.Proposal => "badge-stage-prop",
                            OpportunityStage.Negotiation => "badge-stage-neg",
                            OpportunityStage.Won => "badge-stage-won",
                            OpportunityStage.Lost => "badge-stage-lost",
                            _ => "bg-secondary"
                        };

                        <tr>
                            <td class="fw-semibold">
                                <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@o.OpportunityId" class="text-decoration-none">
                                    @o.OpportunityName
                                </a>
                            </td>
                            <td>@(o.Customer?.CustomerName ?? "—")</td>
                            <td class="fw-semibold">₹@o.Amount.ToString("N2")</td>
                            <td><span class="badge @stageBadge">@o.Stage</span></td>
                            <td>@o.Probability%</td>
                            <td class="text-secondary">₹@o.WeightedAmount.ToString("N2")</td>
                            <td><span class="badge @(o.Status == OpportunityStatus.Won ? "bg-success" : o.Status == OpportunityStatus.Lost ? "bg-danger" : "bg-info text-dark")">@o.Status</span></td>
                            <td>@(o.AssignedToUser?.FullName ?? "Unassigned")</td>
                            <td class="text-secondary small">@o.ExpectedCloseDate.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-secondary">
                            No opportunities found for this report filter.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-secondary">
                Showing @(((Model.PageNumber - 1) * Model.PageSize) + 1) to @(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount)) of @Model.TotalCount opportunities
            </span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link" asp-action="Opportunities"
                           asp-route-page="@(Model.PageNumber - 1)"
                           asp-route-SearchTerm="@filter.SearchTerm"
                           asp-route-OwnerId="@filter.OwnerId"
                           asp-route-stage="@ViewBag.Stage"
                           asp-route-StartDate="@filter.StartDate?.ToString("yyyy-MM-dd")"
                           asp-route-EndDate="@filter.EndDate?.ToString("yyyy-MM-dd")">Previous</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" asp-action="Opportunities"
                               asp-route-page="@i"
                               asp-route-SearchTerm="@filter.SearchTerm"
                               asp-route-OwnerId="@filter.OwnerId"
                               asp-route-stage="@ViewBag.Stage"
                               asp-route-StartDate="@filter.StartDate?.ToString("yyyy-MM-dd")"
                               asp-route-EndDate="@filter.EndDate?.ToString("yyyy-MM-dd")">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                        <a class="page-link" asp-action="Opportunities"
                           asp-route-page="@(Model.PageNumber + 1)"
                           asp-route-SearchTerm="@filter.SearchTerm"
                           asp-route-OwnerId="@filter.OwnerId"
                           asp-route-stage="@ViewBag.Stage"
                           asp-route-StartDate="@filter.StartDate?.ToString("yyyy-MM-dd")"
                           asp-route-EndDate="@filter.EndDate?.ToString("yyyy-MM-dd")">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

