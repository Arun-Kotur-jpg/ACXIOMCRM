@model AcxiomCRM.Models.ViewModels.UserListViewModel
@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">User Management</h1>
        <p class="text-secondary small mb-0">Manage system users, access roles, and account security</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus me-1"></i> Create User
    </a>
</div>

<!-- Filters -->
<div class="card shadow-sm border mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3">
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-secondary">Search</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by name or email..." />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary">Role</label>
                <select name="roleFilter" class="form-select">
                    <option value="">All Roles</option>
                    <option value="@RoleConstants.Admin" selected="@(Model.RoleFilter == RoleConstants.Admin)">Admin</option>
                    <option value="@RoleConstants.Manager" selected="@(Model.RoleFilter == RoleConstants.Manager)">Manager</option>
                    <option value="@RoleConstants.SalesExecutive" selected="@(Model.RoleFilter == RoleConstants.SalesExecutive)">Sales Executive</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary">Status</label>
                <select name="activeFilter" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="true" selected="@(Model.ActiveFilter == true)">Active Only</option>
                    <option value="false" selected="@(Model.ActiveFilter == false)">Inactive Only</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel me-1"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Table Card -->
<div class="card shadow-sm border">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>User</th>
                    <th>Role</th>
                    <th>Manager</th>
                    <th>Status</th>
                    <th>Security</th>
                    <th>Created</th>
                    <th>Last Login</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Users.Items.Any())
                {
                    @foreach (var user in Model.Users.Items)
                    {
                        var roleBadge = user.Role switch
                        {
                            RoleConstants.Admin => "bg-danger",
                            RoleConstants.Manager => "bg-warning text-dark",
                            _ => "bg-info text-dark"
                        };

                        <tr>
                            <td>
                                <div class="fw-semibold text-dark">@user.FullName</div>
                                <div class="small text-secondary">@user.Email</div>
                            </td>
                            <td><span class="badge @roleBadge">@user.Role</span></td>
                            <td class="text-secondary small">@(user.ManagerName ?? "—")</td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>
                                @if (user.IsLockedOut)
                                {
                                    <span class="badge bg-danger" title="Locked until @user.LockoutEnd?.ToString("g")">
                                        <i class="bi bi-lock-fill me-1"></i> Locked
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-success border">
                                        <i class="bi bi-unlock me-1"></i> OK
                                    </span>
                                }
                            </td>
                            <td class="small text-secondary">@user.CreatedDate.ToString("dd MMM yyyy")</td>
                            <td class="small text-secondary">@(user.LastLoginDate?.ToString("dd MMM yyyy HH:mm") ?? "Never")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-secondary" title="Edit User">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    @if (user.IsLockedOut)
                                    {
                                        <form asp-action="Unlock" asp-route-id="@user.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-warning" title="Unlock Account">
                                                <i class="bi bi-unlock"></i>
                                            </button>
                                        </form>
                                    }

                                    <form asp-action="ToggleActive" asp-route-id="@user.Id" asp-route-isActive="@(!user.IsActive)" method="post" class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to @(user.IsActive ? "deactivate" : "activate") this account?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")" 
                                                title="@(user.IsActive ? "Deactivate" : "Activate")">
                                            <i class="bi @(user.IsActive ? "bi-person-dash" : "bi-person-check")"></i>
                                        </button>
                                    </form>

                                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#resetModal-@user.Id" title="Reset Password">
                                        <i class="bi bi-key"></i>
                                    </button>
                                </div>

                                <!-- Reset Password Modal -->
                                <div class="modal fade" id="resetModal-@user.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered text-start">
                                        <div class="modal-content">
                                            <form asp-action="ResetPassword" asp-route-id="@user.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <div class="modal-header">
                                                    <h5 class="modal-title h6">Reset Password for @user.FullName</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-semibold text-secondary">New Password</label>
                                                        <input type="password" name="newPassword" class="form-control" placeholder="Min. 10 characters" required minlength="10" />
                                                        <div class="form-text small">Must contain uppercase, lowercase, number, and special character.</div>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-sm btn-danger">Reset Password</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-secondary">
                            <i class="bi bi-people display-6 d-block mb-2 text-muted"></i>
                            No users found matching your criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.Users.TotalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-secondary">
                Showing @(((Model.Users.PageNumber - 1) * Model.Users.PageSize) + 1) to 
                @(Math.Min(Model.Users.PageNumber * Model.Users.PageSize, Model.Users.TotalCount)) of @Model.Users.TotalCount users
            </span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Users.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@(Model.Users.PageNumber - 1)"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-roleFilter="@Model.RoleFilter"
                           asp-route-activeFilter="@Model.ActiveFilter">Previous</a>
                    </li>
                    @for (int i = 1; i <= Model.Users.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Users.PageNumber ? "active" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-page="@i"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-roleFilter="@Model.RoleFilter"
                               asp-route-activeFilter="@Model.ActiveFilter">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.Users.HasNextPage ? "" : "disabled")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-page="@(Model.Users.PageNumber + 1)"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-roleFilter="@Model.RoleFilter"
                           asp-route-activeFilter="@Model.ActiveFilter">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

