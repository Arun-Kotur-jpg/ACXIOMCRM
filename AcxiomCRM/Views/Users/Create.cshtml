@model AcxiomCRM.Models.ViewModels.UserCreateViewModel
@{
    ViewData["Title"] = "Create User";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h1 class="h3 fw-bold text-dark mb-1">Create User</h1>
                <p class="text-secondary small mb-0">Add a new user to the system with role assignments</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Users
            </a>
        </div>

        <div class="card shadow-sm border">
            <div class="card-body p-4">
                <form asp-action="Create" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-4" role="alert"></div>

                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">User Profile</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="FullName" class="form-control" placeholder="e.g. Rahul Sharma" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Email" class="form-control" type="email" placeholder="rahul@acxiomcrm.local" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                    </div>

                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">Credentials</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Password" class="form-control" placeholder="Min. 10 characters" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Re-enter password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">Role & Hierarchy</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="Role" class="form-select" asp-items="Model.AvailableRoles"></select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ManagerId" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="ManagerId" class="form-select" asp-items="Model.AvailableManagers">
                                <option value="">-- No Direct Manager --</option>
                            </select>
                            <span asp-validation-for="ManagerId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-person-check me-1"></i> Create User
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

