@model List<AcxiomCRM.Models.Entities.AuditLog>
@{
    ViewData["Title"] = "Audit Logs";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
    int pageSize = ViewBag.PageSize ?? 20;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">Security &amp; Audit Logs</h1>
        <p class="text-secondary small mb-0">Immutable record of system activities, auth events, and data changes</p>
    </div>
    <span class="badge bg-secondary p-2">Total Events: @totalCount</span>
</div>

<!-- Filters -->
<div class="card shadow-sm border mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3">
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary">Search</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="User, details, record ID..." />
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-secondary">Module / Entity</label>
                <input type="text" name="module" value="@ViewBag.Module" class="form-control" placeholder="e.g. Lead, Auth, Customer" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-secondary">Action</label>
                <input type="text" name="actionName" value="@ViewBag.ActionName" class="form-control" placeholder="e.g. Login, Create, Delete" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-secondary">Result</label>
                <select name="result" class="form-select">
                    <option value="">All Results</option>
                    <option value="Success" selected="@(ViewBag.Result == "Success")">Success</option>
                    <option value="Failed" selected="@(ViewBag.Result == "Failed")">Failed</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel me-1"></i> Filter Logs
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Audit Table Card -->
<div class="card shadow-sm border">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 font-monospace small">
            <thead class="table-light font-sans-serif">
                <tr>
                    <th style="width: 170px;">Timestamp</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Entity / Module</th>
                    <th>Record ID</th>
                    <th>Result</th>
                    <th>IP Address</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td class="text-secondary">@log.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="fw-semibold text-dark">@(log.PerformedByName ?? "Anonymous / System")</td>
                            <td><span class="badge bg-light text-dark border">@log.ActionName</span></td>
                            <td>@log.EntityName</td>
                            <td class="text-secondary">@(string.IsNullOrEmpty(log.RecordId) ? "—" : log.RecordId)</td>
                            <td>
                                @if (log.Result == "Success")
                                {
                                    <span class="badge bg-success">Success</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">@log.Result</span>
                                }
                            </td>
                            <td class="text-secondary">@(log.IpAddress ?? "::1")</td>
                            <td class="text-secondary" style="max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@log.Details">
                                @log.Details
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-secondary">
                            <i class="bi bi-shield-check display-6 d-block mb-2 text-muted"></i>
                            No audit log events found matching your filter criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-secondary">
                Showing @(((currentPage - 1) * pageSize) + 1) to @(Math.Min(currentPage * pageSize, totalCount)) of @totalCount log entries
            </span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage > 1 ? "" : "disabled")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(currentPage - 1)"
                           asp-route-searchTerm="@ViewBag.SearchTerm"
                           asp-route-module="@ViewBag.Module"
                           asp-route-actionName="@ViewBag.ActionName"
                           asp-route-result="@ViewBag.Result">Previous</a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-page="@i"
                               asp-route-searchTerm="@ViewBag.SearchTerm"
                               asp-route-module="@ViewBag.Module"
                               asp-route-actionName="@ViewBag.ActionName"
                               asp-route-result="@ViewBag.Result">@i</a>
                        </li>
                    }
                    <li class="page-item @(currentPage < totalPages ? "" : "disabled")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@(currentPage + 1)"
                           asp-route-searchTerm="@ViewBag.SearchTerm"
                           asp-route-module="@ViewBag.Module"
                           asp-route-actionName="@ViewBag.ActionName"
                           asp-route-result="@ViewBag.Result">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

