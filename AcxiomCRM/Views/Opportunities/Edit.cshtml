@model AcxiomCRM.Models.ViewModels.OpportunityCreateEditViewModel
@{
    ViewData["Title"] = "Edit Opportunity";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h1 class="h3 fw-bold text-dark mb-1">Edit Opportunity</h1>
                <p class="text-secondary small mb-0">Update deal information and stage progression</p>
            </div>
            <a asp-action="Details" asp-route-id="@Model.OpportunityId" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Details
            </a>
        </div>

        <div class="card shadow-sm border">
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.OpportunityId" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="OpportunityId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-4" role="alert"></div>

                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">Deal Details</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="OpportunityName" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="OpportunityName" class="form-control" />
                            <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="CustomerId" class="form-select" asp-items="Model.AvailableCustomers">
                                <option value="">-- Select Customer --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LeadId" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="LeadId" class="form-select" asp-items="Model.AvailableLeads">
                                <option value="">-- None / Direct Opportunity --</option>
                            </select>
                            <span asp-validation-for="LeadId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Source" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="Source" class="form-control" />
                            <span asp-validation-for="Source" class="text-danger small"></span>
                        </div>
                    </div>

                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">Financials & Stage</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="Amount" class="form-label small fw-semibold text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">₹</span>
                                <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Stage" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="Stage" class="form-select" asp-items="Html.GetEnumSelectList<AcxiomCRM.Models.Enums.OpportunityStage>()"></select>
                            <span asp-validation-for="Stage" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Probability" class="form-label small fw-semibold text-secondary"></label>
                            <div class="input-group">
                                <input asp-for="Probability" class="form-control" type="number" min="0" max="100" />
                                <span class="input-group-text bg-light">%</span>
                            </div>
                            <span asp-validation-for="Probability" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ExpectedCloseDate" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="ExpectedCloseDate" class="form-control" type="date" />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<AcxiomCRM.Models.Enums.OpportunityStatus>()"></select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                    </div>

                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">Assignment & Notes</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="AssignedTo" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="AssignedTo" class="form-select" asp-items="Model.AvailableAssignees"></select>
                            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Notes" class="form-label small fw-semibold text-secondary"></label>
                            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Details" asp-route-id="@Model.OpportunityId" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i> Update Opportunity
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

