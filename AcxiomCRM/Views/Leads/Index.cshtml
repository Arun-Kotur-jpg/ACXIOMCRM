@model AcxiomCRM.Models.ViewModels.LeadListViewModel
@using AcxiomCRM.Models.Enums

@{
    ViewData["Title"] = "Leads";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">
            <i class="bi bi-person-lines-fill me-2"></i>Leads
        </h1>
        <p class="text-muted mb-0">Manage and track your sales leads</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>New Lead
    </a>
</div>

<!-- Filters -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get">
            <div class="row g-3">
                <div class="col-md-4 col-lg-3">
                    <label class="form-label fw-semibold">Search</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Name, email, code..." />
                    </div>
                </div>
                <div class="col-md-4 col-lg-2">
                    <label class="form-label fw-semibold">Status</label>
                    <select name="statusFilter" class="form-select" asp-items="Html.GetEnumSelectList<LeadStatus>()">
                        <option value="">All Statuses</option>
                    </select>
                </div>
                <div class="col-md-4 col-lg-2">
                    <label class="form-label fw-semibold">Priority</label>
                    <select name="priorityFilter" class="form-select" asp-items="Html.GetEnumSelectList<LeadPriority>()">
                        <option value="">All Priorities</option>
                    </select>
                </div>
                <div class="col-md-4 col-lg-2">
                    <label class="form-label fw-semibold">Source</label>
                    <select name="sourceFilter" class="form-select" asp-items="Html.GetEnumSelectList<LeadSource>()">
                        <option value="">All Sources</option>
                    </select>
                </div>
                <div class="col-md-4 col-lg-2">
                    <label class="form-label fw-semibold">Assignee</label>
                    <select name="assigneeFilter" class="form-select" asp-items="Model.AvailableAssignees">
                        <option value="">All Assignees</option>
                    </select>
                </div>
                <div class="col-md-4 col-lg-1 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel me-1"></i>Apply
                    </button>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-12 text-end">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-x-circle me-1"></i>Clear Filters
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model.Leads != null && Model.Leads.Items.Any())
{
    <!-- Results Table -->
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Source</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th class="text-end">Expected Value</th>
                        <th>Assigned To</th>
                        <th>Created</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lead in Model.Leads.Items)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@lead.LeadId" class="fw-semibold text-decoration-none">
                                    @lead.LeadCode
                                </a>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@lead.LeadId" class="text-decoration-none">
                                    @lead.LeadName
                                </a>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(lead.Email))
                                {
                                    <a href="mailto:@lead.Email" class="text-decoration-none">@lead.Email</a>
                                }
                            </td>
                            <td>@lead.Phone</td>
                            <td>
                                @{
                                    var sourceIcon = lead.Source switch
                                    {
                                        LeadSource.Website => "bi-globe",
                                        LeadSource.Referral => "bi-people",
                                        LeadSource.ColdCall => "bi-telephone",
                                        LeadSource.Advertisement => "bi-megaphone",
                                        LeadSource.Partner => "bi-handshake",
                                        _ => "bi-three-dots"
                                    };
                                }
                                <i class="bi @sourceIcon me-1"></i>@lead.Source
                            </td>
                            <td>
                                @{
                                    var statusBadge = lead.Status switch
                                    {
                                        LeadStatus.New => "bg-info",
                                        LeadStatus.Contacted => "bg-primary",
                                        LeadStatus.Qualified => "bg-success",
                                        LeadStatus.Unqualified => "bg-secondary",
                                        LeadStatus.Converted => "bg-dark",
                                        LeadStatus.Lost => "bg-danger",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @statusBadge">@lead.Status</span>
                            </td>
                            <td>
                                @{
                                    var priorityBadge = lead.Priority switch
                                    {
                                        LeadPriority.Low => "bg-secondary",
                                        LeadPriority.Medium => "bg-warning text-dark",
                                        LeadPriority.High => "bg-danger",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @priorityBadge">@lead.Priority</span>
                            </td>
                            <td class="text-end">
                                @if (lead.ExpectedValue.HasValue)
                                {
                                    <span>₹@lead.ExpectedValue.Value.ToString("N2")</span>
                                }
                            </td>
                            <td>@lead.AssignedToUser?.FullName</td>
                            <td>@lead.CreatedDate.ToString("dd MMM yyyy")</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@lead.LeadId" class="btn btn-sm btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.Leads.TotalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center">
                <small class="text-muted">
                    Showing @((Model.Leads.CurrentPage - 1) * Model.Leads.PageSize + 1)–@(Math.Min(Model.Leads.CurrentPage * Model.Leads.PageSize, Model.Leads.TotalCount)) of @Model.Leads.TotalCount leads
                </small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Leads.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.Leads.CurrentPage - 1)"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-statusFilter="@Model.StatusFilter"
                               asp-route-priorityFilter="@Model.PriorityFilter"
                               asp-route-sourceFilter="@Model.SourceFilter"
                               asp-route-assigneeFilter="@Model.AssigneeFilter"
                               asp-route-sortBy="@Model.SortBy">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        @for (int i = 1; i <= Model.Leads.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.Leads.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-statusFilter="@Model.StatusFilter"
                                   asp-route-priorityFilter="@Model.PriorityFilter"
                                   asp-route-sourceFilter="@Model.SourceFilter"
                                   asp-route-assigneeFilter="@Model.AssigneeFilter"
                                   asp-route-sortBy="@Model.SortBy">
                                    @i
                                </a>
                            </li>
                        }
                        <li class="page-item @(Model.Leads.CurrentPage == Model.Leads.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.Leads.CurrentPage + 1)"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-statusFilter="@Model.StatusFilter"
                               asp-route-priorityFilter="@Model.PriorityFilter"
                               asp-route-sourceFilter="@Model.SourceFilter"
                               asp-route-assigneeFilter="@Model.AssigneeFilter"
                               asp-route-sortBy="@Model.SortBy">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
}
else
{
    <!-- Empty State -->
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-person-lines-fill display-1 text-muted"></i>
            <h4 class="mt-3">No Leads Found</h4>
            <p class="text-muted mb-4">
                @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.StatusFilter.HasValue || Model.PriorityFilter.HasValue || Model.SourceFilter.HasValue || !string.IsNullOrEmpty(Model.AssigneeFilter))
                {
                    <span>No leads match your current filters. Try adjusting your search criteria.</span>
                }
                else
                {
                    <span>Get started by creating your first lead.</span>
                }
            </p>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Create New Lead
            </a>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Pre-select filter dropdowns based on current filter values
        document.addEventListener('DOMContentLoaded', function () {
            const statusFilter = '@((int?)Model.StatusFilter)';
            const priorityFilter = '@((int?)Model.PriorityFilter)';
            const sourceFilter = '@((int?)Model.SourceFilter)';
            const assigneeFilter = '@Model.AssigneeFilter';

            if (statusFilter) document.querySelector('[name="statusFilter"]').value = statusFilter;
            if (priorityFilter) document.querySelector('[name="priorityFilter"]').value = priorityFilter;
            if (sourceFilter) document.querySelector('[name="sourceFilter"]').value = sourceFilter;
            if (assigneeFilter) document.querySelector('[name="assigneeFilter"]').value = assigneeFilter;
        });
    </script>
}
