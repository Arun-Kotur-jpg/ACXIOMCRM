@model AcxiomCRM.Models.ViewModels.RegisterViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Create Account";
}

<h2 class="h5 fw-bold mb-3 text-dark text-center">Create New Account</h2>
<p class="text-secondary small text-center mb-4">Register as a new Sales Executive</p>

<form asp-controller="Account" asp-action="Register" method="post" novalidate>
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3" role="alert"></div>

    <div class="mb-3">
        <label asp-for="FullName" class="form-label small fw-semibold text-secondary"></label>
        <div class="input-group">
            <span class="input-group-text bg-light text-secondary"><i class="bi bi-person"></i></span>
            <input asp-for="FullName" class="form-control" placeholder="John Doe" />
        </div>
        <span asp-validation-for="FullName" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label small fw-semibold text-secondary"></label>
        <div class="input-group">
            <span class="input-group-text bg-light text-secondary"><i class="bi bi-envelope"></i></span>
            <input asp-for="Email" class="form-control" type="email" placeholder="name@company.com" />
        </div>
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label small fw-semibold text-secondary"></label>
        <div class="input-group">
            <span class="input-group-text bg-light text-secondary"><i class="bi bi-lock"></i></span>
            <input asp-for="Password" class="form-control" placeholder="Min. 10 characters" />
        </div>
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-secondary"></label>
        <div class="input-group">
            <span class="input-group-text bg-light text-secondary"><i class="bi bi-shield-check"></i></span>
            <input asp-for="ConfirmPassword" class="form-control" placeholder="Re-enter password" />
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
        <i class="bi bi-person-plus me-1"></i> Register
    </button>
</form>

<div class="text-center mt-4 pt-3 border-top">
    <span class="small text-secondary">Already have an account? </span>
    <a asp-action="Login" class="small text-decoration-none fw-semibold">Sign in</a>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

