@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm p-4 border">
                <div class="text-warning mb-3">
                    <i class="bi bi-shield-lock-fill display-4"></i>
                </div>
                <h2 class="h4 mb-2">Access Denied</h2>
                <p class="text-secondary mb-4">
                    You do not have the required permissions or role to access this resource. Please contact your system administrator if you believe this is an error.
                </p>
                <div>
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-house-door me-1"></i> Return to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

