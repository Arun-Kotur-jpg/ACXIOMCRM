@model AcxiomCRM.Models.ViewModels.LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign In";
}

<h2 class="h5 fw-bold mb-3 text-dark text-center">Sign In to Your Account</h2>

<form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3" role="alert"></div>

    <div class="mb-3">
        <label asp-for="EmailOrUsername" class="form-label small fw-semibold text-secondary"></label>
        <div class="input-group">
            <span class="input-group-text bg-light text-secondary"><i class="bi bi-person"></i></span>
            <input asp-for="EmailOrUsername" class="form-control" id="EmailOrUsername" placeholder="admin@acxiomcrm.local" autofocus />
        </div>
        <span asp-validation-for="EmailOrUsername" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label small fw-semibold text-secondary"></label>
        <div class="input-group">
            <span class="input-group-text bg-light text-secondary"><i class="bi bi-lock"></i></span>
            <input asp-for="Password" class="form-control" id="Password" type="password" placeholder="••••••••" />
        </div>
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="form-check">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label small text-secondary"></label>
        </div>
    </div>

    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
    </button>
</form>

<div class="text-center mt-3 pt-3 border-top">
    <span class="small text-secondary">New user? </span>
    <a asp-action="Register" class="small text-decoration-none fw-semibold">Create an account</a>
</div>

<div class="mt-4 p-3 bg-light rounded border text-muted small text-start">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="fw-semibold text-dark"><i class="bi bi-key-fill text-primary me-1"></i> Quick Fill Demo Accounts:</span>
    </div>
    <div class="d-grid gap-2 mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary text-start d-flex justify-content-between align-items-center py-1 px-2" onclick="quickFill('admin@acxiomcrm.local', 'Admin@123456!')">
            <span><strong>Admin</strong> <span class="text-muted">(Full Access)</span></span>
            <span class="badge bg-danger-subtle text-danger border">Admin@123456!</span>
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary text-start d-flex justify-content-between align-items-center py-1 px-2" onclick="quickFill('manager@acxiomcrm.local', 'Demo@123456!')">
            <span><strong>Manager</strong> <span class="text-muted">(Team Scope)</span></span>
            <span class="badge bg-warning-subtle text-warning-emphasis border">Demo@123456!</span>
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary text-start d-flex justify-content-between align-items-center py-1 px-2" onclick="quickFill('sales1@acxiomcrm.local', 'Demo@123456!')">
            <span><strong>Sales Exec</strong> <span class="text-muted">(Own Records)</span></span>
            <span class="badge bg-info-subtle text-info-emphasis border">Demo@123456!</span>
        </button>
    </div>
    <div class="text-muted text-center" style="font-size: 0.72rem;">Click any role above to automatically load credentials</div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        function quickFill(user, pass) {
            var userEl = document.getElementById('EmailOrUsername');
            var passEl = document.getElementById('Password');
            if (userEl) userEl.value = user;
            if (passEl) passEl.value = pass;
        }
    </script>
}

