@model AcxiomCRM.Models.ViewModels.ActivityCreateEditViewModel
@using AcxiomCRM.Models.Enums

@{
    ViewData["Title"] = "Log Activity";
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary me-3">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h1 class="h3 mb-0"><i class="bi bi-journal-plus me-2"></i>Log Activity</h1>
        <p class="text-muted mb-0">Record a new activity</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row">
                        <!-- Activity Type -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="ActivityType" class="form-label fw-semibold">
                                Activity Type <span class="text-danger">*</span>
                            </label>
                            <select asp-for="ActivityType" class="form-select"
                                    asp-items="Html.GetEnumSelectList<ActivityType>()">
                                <option value="">— Select Type —</option>
                            </select>
                            <span asp-validation-for="ActivityType" class="text-danger small"></span>
                        </div>

                        <!-- Status -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="Status" class="form-label fw-semibold">
                                Status <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Status" class="form-select"
                                    asp-items="Html.GetEnumSelectList<ActivityStatus>()">
                                <option value="">— Select Status —</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Subject -->
                    <div class="mb-3">
                        <label asp-for="Subject" class="form-label fw-semibold">
                            Subject <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Subject" class="form-control" placeholder="Enter activity subject" />
                        <span asp-validation-for="Subject" class="text-danger small"></span>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="4"
                                  placeholder="Describe the activity details..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <!-- Activity Date -->
                    <div class="mb-3">
                        <label asp-for="ActivityDate" class="form-label fw-semibold">
                            Date &amp; Time <span class="text-danger">*</span>
                        </label>
                        <input asp-for="ActivityDate" type="datetime-local" class="form-control" />
                        <span asp-validation-for="ActivityDate" class="text-danger small"></span>
                    </div>

                    <hr class="my-4" />
                    <h6 class="text-muted mb-3"><i class="bi bi-link-45deg me-1"></i>Related To (Optional)</h6>

                    <div class="row">
                        <!-- Customer -->
                        <div class="col-md-4 mb-3">
                            <label asp-for="CustomerId" class="form-label fw-semibold">Customer</label>
                            <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers">
                                <option value="">— None —</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <!-- Lead -->
                        <div class="col-md-4 mb-3">
                            <label asp-for="LeadId" class="form-label fw-semibold">Lead</label>
                            <select asp-for="LeadId" class="form-select" asp-items="ViewBag.Leads">
                                <option value="">— None —</option>
                            </select>
                            <span asp-validation-for="LeadId" class="text-danger small"></span>
                        </div>

                        <!-- Opportunity -->
                        <div class="col-md-4 mb-3">
                            <label asp-for="OpportunityId" class="form-label fw-semibold">Opportunity</label>
                            <select asp-for="OpportunityId" class="form-select" asp-items="ViewBag.Opportunities">
                                <option value="">— None —</option>
                            </select>
                            <span asp-validation-for="OpportunityId" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <!-- Assigned To -->
                    <div class="mb-4">
                        <label asp-for="AssignedTo" class="form-label fw-semibold">
                            Assigned To <span class="text-danger">*</span>
                        </label>
                        <select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.Users">
                            <option value="">— Select Assignee —</option>
                        </select>
                        <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg me-1"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Log Activity
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
